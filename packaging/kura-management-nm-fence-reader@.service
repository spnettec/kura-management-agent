[Unit]
Description=Observe the fixed Kura NM and firewall fence pair

[Service]
Type=exec
User=root
Group=kura-management
ExecStart=/usr/bin/python3 -I -B /usr/lib/kura-management-agent/fence_reader.py %n
StandardInput=socket
StandardOutput=socket
StandardError=journal
RuntimeMaxSec=5s
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
UMask=0077
