[Unit]
Description=YOFC independent Kura management agent
After=network.target
ConditionPathExists=/etc/kura-management-agent/agent.env
# No Requires/BindsTo/PartOf for Kura and no network-online dependency.

[Service]
Type=simple
User=root
Group=kura-management
EnvironmentFile=/etc/kura-management-agent/agent.env
ExecStartPre=/usr/bin/python3 /usr/lib/kura-management-agent/setup.py check
ExecStart=/usr/bin/yofc-management-agent
Restart=on-failure
RestartSec=3
UMask=0077
RuntimeDirectory=kura-management-agent
RuntimeDirectoryMode=0750
StateDirectory=kura-management-agent
StateDirectoryMode=0700
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN
ProtectSystem=strict
# Mask parent namespaces, including Kura secrets created after agent startup.
# StateDirectory/BindPaths keeps only this agent's own persistent state visible.
TemporaryFileSystem=/etc/kura:ro /var/lib:ro
BindPaths=/var/lib/kura-management-agent
ProtectControlGroups=yes
ProtectHome=yes
PrivateTmp=yes
# Route observation and explicitly delegated writes need route netlink.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
TasksMax=32
MemoryMax=256M
CPUWeight=50

[Install]
WantedBy=multi-user.target
