# Bound identity example only. Clean installation uses init-local instead;
# do not copy placeholder identity fields into an unbound installation.
AGENT_CONSOLE_ENDPOINT=https://console.example.invalid:8443
AGENT_GATEWAY_ID=replace-with-registered-gateway
AGENT_CA=/etc/kura-management-agent/ca.pem
AGENT_CERT=/etc/kura-management-agent/agent.pem
AGENT_KEY=/etc/kura-management-agent/agent.key
AGENT_BINDING_GENERATION=1
AGENT_STATE_DB=/var/lib/kura-management-agent/results.sqlite
AGENT_SOCKET=/run/kura-management-agent/control.sock
# No Kura access until kura-agent-setup authorize-kura records the actual OS UID.
# uid_t -1 is deliberately not a valid Linux account; never use nobody as a placeholder.
AGENT_KURA_UID=4294967295
AGENT_ADMIN_UID=0
# Even after Kura authorization, observation only; no delegated network writes.
AGENT_KURA_NETWORK_INTERFACES=
# Empty means observation only. Sources owned by another writer still cause CONFLICT.
AGENT_NETWORK_INTERFACES=
# Test fixtures only; production requires a physical wired interface.
AGENT_NETWORK_ALLOW_VIRTUAL_FIXTURE=0
# Local firewall changes require explicit operator opt-in; observation remains available.
AGENT_FIREWALL_WRITE=0
# Empty means offline recovery is disabled. Review the dedicated sandbox drop-in
# and snapshot owner before configuring a fixed unit allow-list.
AGENT_RECOVERY_UNITS=
# Optional reviewed Java format adapter. No tool/mode/key auto-detection.
# Without this opt-in, the historical artifact/unit-only diagnostic remains.
# AGENT_RECOVERY_VALIDATOR_CONFIG=/etc/kura-management-agent/snapshot-validator.json
# Optional fixed CM application/inverse/guarded ordinary-load profiles. Disabled unless granted.
# AGENT_RECOVERY_STARTUP_CONFIG=/etc/kura-management-agent/recovery-startup.json
# AGENT_RECOVERY_COMPENSATION_STARTUP_CONFIG=/etc/kura-management-agent/recovery-inverse.json
# AGENT_RECOVERY_NORMAL_STARTUP_CONFIG=/etc/kura-management-agent/recovery-normal.json
# Optional explicit acceptance of a fully applied forward recovery; absent keeps inverse-only normal preparation.
# AGENT_RECOVERY_FORWARD_NORMAL_CONFIG=/etc/kura-management-agent/recovery-forward-normal.json
# Separate explicit format grant for the retained baseline; never downgrade the upload policy.
# AGENT_RECOVERY_NORMAL_VALIDATOR_CONFIG=/etc/kura-management-agent/recovery-normal-validator.json
# Optional selected-health completion and fixed ordinary unit handoff. Disabled by default.
# AGENT_RECOVERY_HEALTH_CONFIG=/etc/kura-management-agent/recovery-health.json
# AGENT_RECOVERY_COMPLETION_CONFIG=/etc/kura-management-agent/recovery-completion.json
# AGENT_RECOVERY_ORDINARY_STARTUP_CONFIG=/etc/kura-management-agent/recovery-ordinary.json
# Optional independent ordinary snapshot format grant; never inferred from normal/legacy policy.
# AGENT_RECOVERY_ORDINARY_VALIDATOR_CONFIG=/etc/kura-management-agent/recovery-ordinary-validator.json
# Bound-center ordinary-profile handoff requires the fixed grant above and an
# already approved local completion. Does not enable boot or restart/reboot.
AGENT_RECOVERY_ORDINARY_REMOTE=0
RUST_LOG=info

# Initial decision for a new remote-management state only. Existing durable decisions win.
AGENT_REMOTE_ENABLED=0
# Optional narrow delegation for the authenticated local Kura admin UI.
AGENT_KURA_REMOTE_MANAGEMENT=0

# Optional first enrollment grant; absent by default. Kura owns this fixed 0700 staging root.
# Independent of AGENT_KURA_REMOTE_MANAGEMENT; never pass private key bytes over UDS.
# AGENT_KURA_ENROLLMENT_DIR=/opt/eclipse/kura/data/management-enrollment

# Optional fixed private native boot policy request; absent keeps remote/UDS boot methods off.
# AGENT_ORDINARY_BOOT_REQUEST=/etc/kura-management-agent/ordinary-boot-request.json

# Installation-reviewed fixed Kura service, absent by default. The root-only
# configure-system-control command seals effective unit/file pins. Restart and
# host reboot are separate grants; neither accepts a caller-supplied target.
# AGENT_SYSTEM_CONTROL_CONFIG=/etc/kura-management-agent/system-control-UUID.json
AGENT_SYSTEM_CONTROL_REMOTE=0
